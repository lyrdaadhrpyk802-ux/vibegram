# ============================================
#  .env.example - template for vibegram environment configuration
#  Copy to .env and fill in your values. Never commit the real .env.
# ============================================

# Vibe app credentials. Defaults are Vibe's official public app id;
# override only if you have your own registered app.
VIBE_API_ID=4
VIBE_API_HASH=014b35b6184100b085b0d0572f9b5103

# Datacenter settings (override for self-hosted or mirrored Vibe servers).
VIBE_DC_HOST=web.vibegram.chat
VIBE_DC_PORT=443
VIBE_DC_ID=2

# HTTP Bot API base URL (used by botapi.VibeBotHTTP).
# Leave empty to use the built-in default.
# VIBE_BOT_API_BASE=https://bot.vibegram.chat

# HTTP Bot API token for examples that use the HTTP Bot API.
# NEVER hardcode in source. Use placeholder in examples.
# VIBE_BOT_TOKEN=YOUR_TOKEN_HERE
